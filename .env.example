# Supabase (Project settings → API keys). The secret key is server-only —
# never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Public values used by the browser for direct-to-storage uploads
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Protects /api/cron/cleanup (Vercel sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
